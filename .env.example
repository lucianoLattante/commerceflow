# Copy to .env and replace every placeholder. Never use production credentials.
CF_DB_NAME=commerceflow
CF_DB_USER=commerceflow
CF_DB_PASSWORD=replace-with-random-local-password
CF_DB_ROOT_PASSWORD=replace-with-different-random-local-password
CF_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
CF_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Host execution: messaging is opt-in; Compose enables its local Kafka service.
CF_MESSAGING_ENABLED=false
CF_KAFKA_BOOTSTRAP=127.0.0.1:9092

# Admission protection is opt-in for host execution; Compose enables it.
CF_RATE_LIMIT_ENABLED=false
CF_REDIS_HOST=127.0.0.1
CF_REDIS_PORT=6379
CF_REDIS_PASSWORD=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
